# BreachGraph AI configuration.
# Copy this file to `.env` in the same folder (breachgraph/.env) and fill in your own values.
# `.env` is git-ignored. Never commit it, and never paste your key into chat, issues or code.
# Real environment variables take precedence over values in this file.

# Your Meta Model API key. Leave empty to run without AI explanations
# (analysis, the graph and the simulator all work without it).
MODEL_API_KEY=

# OpenAI-compatible base URL of the Meta Model API.
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Model id. Confirm which ids your account serves with:  python scripts/live_ai_check.py --list-models
MODEL_NAME=muse-spark-1.3

# Seconds to wait for the model before giving up.
MODEL_TIMEOUT_SECONDS=30
